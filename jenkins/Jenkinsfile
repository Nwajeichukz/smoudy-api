pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building the Spring Boot app...'
                sh 'chmod +x ./mvnw'
                sh './mvnw clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                sh './mvnw test'
            }
        }

        stage('Deploy') {
            when {
                not { changeRequest() }
                branch 'dev' // Only deploy if it's the dev branch
            }
            steps {
                echo 'Deploying to DEV environment...'
                sh 'docker compose -p smoudy-dev down --remove-orphans || true'
                sh 'docker compose -p smoudy-dev up -d --build'
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline succeeded! 🎉'
        }
        failure {
            echo 'Pipeline failed! ❌'
        }
    }
}